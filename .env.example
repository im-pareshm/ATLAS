# ATLAS — environment template. Copy to `.env` and fill in.

# --- Database ---
# LOCAL DEV (libSQL file, no Turso account needed):
#   DATABASE_URL="file:./dev.db"            # Prisma CLI (relative to prisma/)
#   TURSO_DATABASE_URL="file:./prisma/dev.db"  # runtime libSQL (relative to project root)
#   TURSO_AUTH_TOKEN=""
# PRODUCTION (Turso):
#   DATABASE_URL="libsql://<db>-<org>.turso.io?authToken=<token>"  # for prisma migrate deploy
#   TURSO_DATABASE_URL="libsql://<db>-<org>.turso.io"              # runtime
#   TURSO_AUTH_TOKEN="<token>"
DATABASE_URL="file:./dev.db"
TURSO_DATABASE_URL="file:./prisma/dev.db"
TURSO_AUTH_TOKEN=""

# --- Auth.js (NextAuth v5) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# --- Seed (used only by `npm run db:seed`) ---
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me"
